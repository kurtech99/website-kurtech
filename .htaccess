# ==============================================================================
# KURTECH WEB SECURITY, HARDENING & SPEED OPTIMIZATION (.htaccess)
# ==============================================================================

# 1. MATIKAN DIRECTORY LISTING & SERVER SIGNATURE
Options -Indexes -MultiViews
ServerSignature Off

# 2. DEFAULT CHARSET & UTF-8
AddDefaultCharset UTF-8

# 3. BLOKIR AKSES KE FILE SENSITIF, CONFIG, REPO, DAN MARKDOWN
<FilesMatch "(^\.|\.env|\.git|\.bak|\.log|\.sql|\.config|\.ini|\.sh|\.md|\.markdown|intruksi|composer\.|package\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. HTTP SECURITY HEADERS (Perlindungan Anti-XSS, Anti-Clickjacking, Anti-Sniffing)
<IfModule mod_headers.c>
    # Mencegah Clickjacking (Situs di-embed dalam iframe palsu)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Mencegah MIME Type Sniffing (Eksploitasi file upload/tipe file)
    Header always set X-Content-Type-Options "nosniff"

    # Filter XSS bawaan browser modern
    Header always set X-XSS-Protection "1; mode=block"

    # Keamanan Pengalihan URL (Referrer)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Izin Akses Fitur Perangkat (Permissions Policy)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Paksa HTTPS HSTS (Strict-Transport-Security) jika menggunakan HTTPS
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # Sembunyikan informasi versi server & backend agar tidak di-scan hacker
    Header unset X-Powered-By
    Header always unset Server
</IfModule>

# 5. REWRITE ENGINE: PERLINDUNGAN FIREWALL WEB (WAF RULES)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # A. PAKSA KONEKSI AMAN HTTPS (SSL REDIRECT OTOMATIS)
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|.*\.test)$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # B. BLOKIR METODE HTTP YANG BERBAHAYA (Hanya izinkan GET, POST, HEAD)
    RewriteCond %{REQUEST_METHOD} ^(TRACE|DELETE|TRACK|DEBUG|PUT|OPTIONS) [NC]
    RewriteRule ^.*$ - [F,L]

    # C. BLOKIR SQL INJECTION PADA QUERY STRING
    RewriteCond %{QUERY_STRING} (concat|union|select|insert|cast|set|declare|drop|md5|benchmark) [NC,OR]
    RewriteCond %{QUERY_STRING} (information_schema|into.*outfile|load_file) [NC]
    RewriteRule ^.*$ - [F,L]

    # D. BLOKIR XSS & SCRIPT INJECTION PADA URL
    RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} (javascript:|eval\(|base64_decode|base64_encode) [NC]
    RewriteRule ^.*$ - [F,L]

    # E. BLOKIR DIRECTORY TRAVERSAL & LOCAL FILE INCLUSION (LFI)
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|etc/passwd|proc/self/environ|boot\.ini) [NC,OR]
    RewriteCond %{QUERY_STRING} (php://input|php://filter) [NC]
    RewriteRule ^.*$ - [F,L]

    # F. BLOKIR SCANNER JAHAT, BAD BOTS & EXPLOIT TOOLS
    RewriteCond %{HTTP_USER_AGENT} (sqlmap|nikto|wpscan|havij|acunetix|dirbuster|nmap|masscan|zgrab|jorgee|metasploit) [NC]
    RewriteRule ^.*$ - [F,L]

    # G. 301 Permanent Redirect untuk link website lama
    RewriteRule ^(about|jaringan-kantor|tips-jaringan|katalog|catalog|produk|product|cart|checkout)/?$ / [R=301,L]

    # H. URL Rewrite: Redirect request yang tidak ada ke halaman utama
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ / [R=301,L]
</IfModule>

# 6. CACHING OTOMATIS & KOMPRESI GZIP (Kecepatan Loading Maksimal)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|css|js|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

